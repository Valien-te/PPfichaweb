{
  "name": "portal-proteccion-patrimonial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite",
    "check:data-contract": "tsx scripts/check-data-contract.ts",
    "check:event-engine": "tsx scripts/check-event-engine.ts",
    "check:simulator": "tsx scripts/check-simulator.ts",
    "check:identificador-gestion": "tsx scripts/check-identificador-gestion-rules.ts",
    "check:tercero-rules": "tsx scripts/check-tercero-rules.ts",
    "check:tercero-inmobiliario": "tsx scripts/check-tercero-inmobiliario-rules.ts",
    "check:cesion-hereditaria-tercero": "tsx scripts/check-cesion-hereditaria-tercero-rules.ts",
    "check:vehiculo-prenda": "tsx scripts/check-vehiculo-prenda-rules.ts",
    "check:documentos-rules": "tsx scripts/check-documentos-rules.ts",
    "check:prototype": "pnpm check:data-contract && pnpm check:event-engine && pnpm check:simulator && pnpm check:identificador-gestion && pnpm check:tercero-rules && pnpm check:tercero-inmobiliario && pnpm check:cesion-hereditaria-tercero && pnpm check:vehiculo-prenda && pnpm check:documentos-rules",
    "build:app": "tsc -b && vite build",
    "build": "pnpm check:prototype && pnpm build:app",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:geometry": "node scripts/check-geometry.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.5",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "7.62.0",
    "react-router": "^7.9.0",
    "sonner": "2.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "terser": "^5.48.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12"
  }
}
